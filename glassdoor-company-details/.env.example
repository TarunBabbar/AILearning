# ------------------------------------------------------------------
# Glassdoor Company Details Portal — environment template.
# Copy these values into your own local file; do NOT commit real secrets.
# ------------------------------------------------------------------

# == OpenRouter (LLM) ==
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2:free
OPENROUTER_TEMPERATURE=0.2

# == Glassdoor (optional, only for automated scrape via Playwright) ==
# Glassdoor blocks automation; scraping may fail. You can instead paste data
# into data/companies.raw.json manually (see README).
GLASSDOOR_EMAIL=
GLASSDOOR_PASSWORD=
GLASSDOOR_BASE_URL=https://www.glassdoor.com
# Set to 1 to launch a visible browser so you can solve any CAPTCHA by hand.
GLASSDOOR_HEADED=1

# == Netlify/Vercel deploys ==
# BASE_URL=