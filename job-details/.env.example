# ── Database ─────────────────────────────────────────────
# Local Postgres (default). For Vercel: set DATABASE_URL to the
# Vercel Postgres / Neon connection string (direct URL recommended).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobdetails?schema=public"

# ── OpenRouter ───────────────────────────────────────────
# Optional — if left blank, the user can supply their key in the UI
# (stored in a session cookie). Set this to use a fixed server-side key.
OPENROUTER_API_KEY=""
# OpenRouter API base URL
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Default model used when the user hasn't picked one in the UI.
# Use a genuinely free model id (see https://openrouter.ai/models?q=free):
#   nvidia/nemotron-3-ultra-550b-a55b:free   (default)
#   openai/gpt-oss-20b:free
#   google/gemma-4-31b-it:free
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# ── Extraction / limits ──────────────────────────────────
# Max PDF pages to extract per file
MAX_PDF_PAGES="50"
# Max jobs per upload request
MAX_JOBS_PER_UPLOAD="200"

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Job Details"
