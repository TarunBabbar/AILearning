# ── Database ─────────────────────────────────────────────
# Local Postgres (default). For Vercel: set DATABASE_URL to the
# Vercel Postgres / Neon connection string (direct URL recommended).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobdetails?schema=public"

# ── OpenRouter ───────────────────────────────────────────
# Optional — if left blank, the user can supply their key in the UI
# (stored in a session cookie). Set this to use a fixed server-side key.
OPENROUTER_API_KEY=""
# OpenRouter API base URL
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Default model used when the user hasn't picked one in the UI.
# Use a genuinely free model id (see https://openrouter.ai/models?q=free).
OPENROUTER_MODEL="nvidia/nemotron-nano-9b-v2:free"

# Max upload size per file (MB) — shown to the user on the Upload page.
NEXT_PUBLIC_MAX_FILE_SIZE_MB="50"

# Email domains treated as personal/free providers — jobs whose contact
# email uses one of these are hidden from the dashboard. Comma-separated.
GENERIC_EMAIL_DOMAINS="gmail.com,yahoo.com,hotmail.com,outlook.com,rediffmail.com,ymail.com,live.com,google.com,icloud.com,aol.com,protonmail.com,zoho.com,mail.com,msn.com,qq.com,163.com,126.com,sina.com,foxmail.com,hey.com,gmx.com"

# Public app URL — sent to OpenRouter as the referer header.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# App name shown in the sidebar / title.
NEXT_PUBLIC_APP_NAME="QA Job Details"

# ── Admin login (Upload page) ────────────────────────────
# Only users who enter these credentials can upload job PDFs.
# Anyone else is directed to browse the existing jobs.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Optional secret for Score Jobs user session cookies (falls back to ADMIN_PASSWORD).
USER_SESSION_SECRET=""

# API key for GET /api/users (list registered Score Jobs accounts).
# Must be non-empty to enable the endpoint. Pass via header:
#   x-api-key: <value>
#   or Authorization: Bearer <value>
USERS_ADMIN_API_KEY=""

# ── Extraction / limits ──────────────────────────────────
# Max PDF pages to extract per file
MAX_PDF_PAGES="50"
# Max jobs per upload request
MAX_JOBS_PER_UPLOAD="200"

# ── Chat assistant (Match by Resume) ──────────────────────
# Floating chat on the Match by Resume page (logged-in users only).
# Project questions are answered by an OpenRouter model; issue/suggestion
# messages are forwarded to the owner's Telegram. Both values are
# server-only — never sent to the browser.
#
# 1. Create a bot: message @BotFather → /newbot → copy the token.
# 2. Message your bot once, then get your chat id (e.g. via
#    https://api.telegram.org/bot<TOKEN>/getUpdates → result[0].message.chat.id)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Optional OpenRouter model for chat auto-answers. Falls back to OPENROUTER_MODEL.
CHATBOT_MODEL=""

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Job Details"
