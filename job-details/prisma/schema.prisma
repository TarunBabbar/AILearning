generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id           String     @id @default(uuid())
  title        String
  company      String
  email        String?
  location     String?
  experience   String?
  description  String?
  fileName     String?
  jobDate      DateTime?
  status       String     @default("new")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  companyId    String?
  companyInfo  Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  scores       JobScore[]

  @@index([companyId])
  @@index([createdAt])
  @@index([jobDate])
  @@index([company])
  @@index([fileName])
}

model Company {
  id          String   @id @default(uuid())
  domain      String   @unique
  name        String
  type        String?
  description String?
  location    String?
  website     String?
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        Job[]
}

/// End-user account for Score Jobs (separate from admin upload login).
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  resume       Resume?
  scores       JobScore[]
}

/// One resume per user — extracted plain text only (no binary).
model Resume {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename  String
  content   String
  mimeType  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Per-user job match scores against the shared Job corpus.
model JobScore {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  score     Int
  strengths String?
  gaps      String?
  scoredAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, score])
}
