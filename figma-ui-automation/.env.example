# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=

# --- Figma (REST API) ---
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=

# --- App under test ---
STAGING_URL=

# --- Eval sidecar (DeepEval) ---
# Set DEEPEVAL_MODE=server to call the FastAPI sidecar.
# Leave it as mock (default) to use the built-in Node judge with no Python dependency.
DEEPEVAL_MODE=mock
DEEPEVAL_URL=http://127.0.0.1:8010

# --- Agents ---
# MODE=sample makes every agent run on bundled sample data (no live Figma/OpenRouter/staging needed).
MODE=live
DRY_RUN=true
