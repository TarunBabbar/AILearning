# OpenRouter API key — required for AI agents
OPENROUTER_API_KEY=

# FREE model only — never use paid models. Free models carry a :free suffix.
# Verified tool-calling free models (probe results, 2026-08):
#   nvidia/nemotron-3-ultra-550b-a55b:free   <- default (550B, 65536 max tokens, clean tool calls, best for long test/script output)
#   openai/gpt-oss-20b:free                   clean tool calls, solid for RI/IQ reasoning
#   google/gemma-4-26b-a4b-it:free            works
#   inclusionai/ling-3.0-flash:free           fast, tool calls OK
#   cohere/north-mini-code:free               code-oriented, tool calls OK
#   poolside/laguna-s-2.1:free / poolside/laguna-xs-2.1:free
#   nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
#   nvidia/nemotron-3-super-120b-a12b:free    (can emit duplicate tool calls, noisier)
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# FREE vision model for image → text extraction (image_extract). Free only.
# Vision-capable free option (unverified): nvidia/nemotron-nano-12b-v2-vl:free
VISION_MODEL=google/gemma-4-26b-a4b-it:free

# Where artifacts persist (default: qae2e/data/)
DATA_DIR=data

# Public app name shown in headers/UI
NEXT_PUBLIC_APP_NAME=QAE2E Agentic Quality Engineering

# ---------------------------------------------------------------------------
# Source connectors (all optional — configure the ones you use)
# ---------------------------------------------------------------------------

# Jira (Cloud): URL + email + API token (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Default project key for defect sync (jira_create_defect) — set if you want run results → Jira
JIRA_PROJECT_KEY=

# Confluence (Cloud): URL + email + API token (same token as Jira Cloud)
CONFLUENCE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Figma: personal access token (https://www.figma.com/developers/api#access-tokens)
FIGMA_TOKEN=

# GitHub: fine-grained PAT with repo read/write (contents:read/write, pull_requests:write)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
# New branch prefix for the check-in flow (e.g. qae2e/test-cases)
GITHUB_NEW_BRANCH_PREFIX=qae2e
# Workflow file to dispatch for the DevOps leg
GITHUB_WORKFLOW_FILE=.github/workflows/e2e.yml

# Zephyr Scale (Cloud, Jira plugin): base URL + API token + project key
ZEPHYR_BASE_URL=
ZEPHYR_TOKEN=
ZEPHYR_PROJECT_KEY=

# TestRail: URL + username/email + API key (your-user → Settings → API Keys)
TESTRAIL_URL=
TESTRAIL_USER=
TESTRAIL_API_KEY=
# Optional run id for posting test results back to TestRail after a run
TESTRAIL_RUN_ID=

# ---------------------------------------------------------------------------
# RAG / embeddings
# ---------------------------------------------------------------------------

# Pinecone (free serverless tier) — https://www.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX=
# Optional: host override (else derived from index name)
PINECONE_HOST=

# Free local embedding model (transformers.js, all-MiniLM-L6-v2) — no API cost
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Run history (persistent, Vercel-compatible)
# ---------------------------------------------------------------------------

# Vercel Postgres (production). When set, pipeline runs (events, generated code,
# test results) are saved to the `qae2e_runs` table and can be re-downloaded as
# a ZIP. When unset (local dev), runs fall back to data/runs.json.
# POSTGRES_URL=postgres://user:pass@host:5432/db
# Or the Vercel Postgres env block:
# POSTGRES_HOST=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DATABASE=
# POSTGRES_URL_NON_POOLING=

# ---------------------------------------------------------------------------
# Local execution
# ---------------------------------------------------------------------------

# Docker image used for the local test run
DOCKER_IMAGE=mcr.microsoft.com/playwright:v1.51.0-jammy

# Command run inside the container (JUnit reporter required for result parsing)
TEST_COMMAND=npx playwright test --reporter=junit

# ---------------------------------------------------------------------------
# Connection test defaults (used by the Connectors panel "Test connection" and
# the sample-connect flow — override with your own test ids)
# ---------------------------------------------------------------------------
TEST_JIRA_ISSUE_KEY=
TEST_CONFLUENCE_PAGE_ID=
TEST_FIGMA_FILE_KEY=
