# ---------------------------------------------------------------------------
# QAE2E — required env config
# Everything else (connector creds, notifications, Pinecone, secrets key) was
# removed with the MCP-placeholder refactor: the current workflow supports
# copy-pasted requirements only.
# ---------------------------------------------------------------------------

# LLM provider API key — used only for the OpenRouter FREE fallback pool.
# If you use the fast Command Code path below (default), this is optional.
OPENROUTER_API_KEY=

# LLM source: "auto" (default) | "openrouter" | "commandcode".
#   auto        — prefer the fast Command Code model (LLM_MODEL / EVAL_MODEL
#                 when they are Command Code ids), fall back to the OpenRouter
#                 free pool if Command Code is unavailable
#   commandcode — always use Command Code
#   openrouter  — OpenRouter free pool only (never paid)
LLM_SOURCE=auto

# Command Code Provider API key — THE FAST PATH. The default models below
# (deepseek-v4-flash-fast) run through this provider and need this key on Vercel
# and locally. Create your API key from https://commandcode.ai/settings/keys
# (Studio). Every plan except Go has API access.
# Without this key, runs silently fall back to the slow OpenRouter free pool.
COMMAND_CODE_API_KEY=

# Command Code Provider API base URL (defaults to the provider endpoint).
# COMMAND_CODE_API_URL=https://api.commandcode.ai/provider/v1

# Model used for the Command Code provider (paid, fast).
COMMAND_CODE_MODEL=deepseek/deepseek-v4-flash-fast

# Legacy: local cmdc CLI path (only used when COMMAND_CODE_API_KEY is unset,
# and only works on machines with Command Code installed).
# COMMAND_CODE_PATH=cmdc

# LLM model used by the agents. The default is a Command Code id (fast path).
# To use OpenRouter free models instead, set LLM_SOURCE=openrouter and use a
# ":free" model such as:
#   nvidia/nemotron-3-ultra-550b-a55b:free
#   openai/gpt-oss-20b:free
#   google/gemma-4-26b-a4b-it:free
LLM_MODEL=deepseek/deepseek-v4-flash-fast

# Fallback pool of OpenRouter FREE models — tried only when the primary model
# is unavailable. Comma-separated. The live free-model list from OpenRouter is
# used as a last-resort source (cached 60s, not per-request).
LLM_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,z-ai/glm-5.2:free,cohere/north-mini-code:free,openai/gpt-oss-20b:free

# LLM model used as the AI-evaluation judge. Same fast-path semantics as
# LLM_MODEL. Falls back to a deterministic lexical score when the judge is
# unavailable.
EVAL_MODEL=deepseek/deepseek-v4-flash-fast

# Fallback pool of OpenRouter free models for the AI-evaluation judge.
EVAL_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Vision model for image → text extraction (image_extract).
VISION_MODEL=google/gemma-4-26b-a4b-it:free

# Optional OpenRouter base URL override (defaults to https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=

# Public app URL — sent as OpenRouter's HTTP-Referer (optional).
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Public app name shown in headers/UI
NEXT_PUBLIC_APP_NAME=QAE2E Agentic Quality Engineering

# Where artifacts persist (default: qae2e/data/)
DATA_DIR=data

# ---------------------------------------------------------------------------
# Local / remote test execution
# ---------------------------------------------------------------------------

# Docker image used for test runs. The runner pulls it automatically when it is
# not present locally (so no manual `docker pull` needed).
# NOTE: Docker test execution only runs when the APP itself is on a machine
# with Docker (typically localhost dev). On Vercel there is no Docker daemon,
# so the pipeline pauses after automation generation and reports "not
# executed" unless a remote runner is configured.
DOCKER_IMAGE=mcr.microsoft.com/playwright:v1.51.0-jammy

# Command run inside the container AFTER the preflight checks (node/npm present,
# `npm install` when node_modules is missing, `playwright install chromium` when
# the browser is missing).
TEST_COMMAND=npm test || npx --yes playwright@1.51.0 test --project=chromium

# Optional remote Docker runner (your machine / VPS): when set, the app POSTs
# the suite here instead of running docker locally. This is how Vercel (no
# Docker) still runs real Playwright suites. Start it with:
#   node scripts/remote-runner.mjs [port] [token]
#   TEST_RUNNER_URL=http://192.168.1.50:8787/run
#   TEST_RUNNER_TOKEN= (same value you passed to the runner; optional)
# TEST_RUNNER_URL=
# TEST_RUNNER_TOKEN=

# ---------------------------------------------------------------------------
# Database — Neon (serverless Postgres)
# ---------------------------------------------------------------------------

# Add your Neon connection string in Vercel → Project → Settings → Environment
# Variables as POSTGRES_URL (or DATABASE_URL). Tables are created automatically
# on first use. Locally, add the same value to .env.
# POSTGRES_URL=postgresql://user:password@host/neondb?sslmode=require
# DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
