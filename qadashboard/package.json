    "dotenv": "^17.4.2",
    "jose": "^6.2.8",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.8.0",
    "next": "^16.3.0",
    "nodemailer": "^9.0.4",
    "openai": "^4.94.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "postcss": "^8.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.0",
    "tailwind-merge": "^3.2.0",
