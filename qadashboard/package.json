{
  "name": "qa-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-env.mjs next dev",
    "build": "node scripts/with-env.mjs next build",
    "start": "node scripts/with-env.mjs next start",
    "lint": "eslint .",
    "db:generate": "node scripts/with-env.mjs prisma generate",
    "db:push": "node scripts/with-env.mjs prisma db push",
