{
  "name": "figma-to-playwright-agents",
  "version": "0.1.0",
  "description": "AI agent pipeline: Figma design -> test cases -> Playwright+TS automation, driven by OpenRouter LLMs and the official Figma MCP server.",
  "type": "module",
  "bin": {
    "figma2pw": "./dist/cli.js"
  },
  "scripts": {
