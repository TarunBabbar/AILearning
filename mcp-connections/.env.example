# ===== OpenRouter =====
# Get an API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used by the analysis / test-case / automation agents.
# Any OpenRouter model id, e.g.:
#   meta-llama/llama-3.3-70b-instruct
#   openai/gpt-4o-mini
#   anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=openai/gpt-4o-mini

# ===== Figma =====
# Personal access token from Figma account settings:
# https://www.figma.com/developers/api#access-tokens
FIGMA_ACCESS_TOKEN=figd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The file key of the Figma design to analyze, from a Figma URL:
#   https://www.figma.com/design/<FILE_KEY>/...
FIGMA_FILE_KEY=
# Optional, comma-separated design-series labels (e.g. "Pricing,Signup").
# Currently informational — the analysis agent reads the whole design.
FIGMA_DESIGN_SERIES=

# ===== Figma MCP server =====
# Command used to launch the Figma MCP server (GLips/Figma-Context-MCP, aka
# Framelink). It runs over stdio (the --stdio flag is required).
# On Windows, cmd.exe is used as the launcher so npx .cmd resolves correctly.
FIGMA_MCP_COMMAND=npx
# Any package name + version, e.g.:
#   figma-developer-mcp --stdio
#   figma-developer-mcp@0.6.2 --stdio
# The server reads your token from the FIGMA_API_KEY env var, which this tool
# forwards automatically from FIGMA_ACCESS_TOKEN.
FIGMA_MCP_ARGS=figma-developer-mcp --stdio

# ===== Output =====
# Where generated test cases (markdown) live.
TESTCASES_OUTPUT_DIR=output/testcases
# Where the generated Playwright project is written.
PLAYWRIGHT_OUTPUT_DIR=playwright
# Default app URL used by generated tests when one can't be derived.
APP_BASE_URL=http://localhost:3000